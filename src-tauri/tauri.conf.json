{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LegalMaster Solo",
  "version": "0.1.0",
  "identifier": "com.legalmaster.solo",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "ليجال ماستر", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 560 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
